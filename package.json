{
  "name": "whatwg-url",
  "version": "17.3.0",
  "description": "An implementation of the WHATWG URL Standard's URL API and parsing machinery",
  "license": "MIT",
  "author": "Sebastian Mayr <github@smayr.name>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdom/whatwg-url.git"
  },
  "files": [
    "index.js",
    "webidl2js-wrapper.js",
    "lib/*.js"
  ],
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "check": "npm run lint && npm run fmt:check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "node scripts/transform.mjs",
    "build:live-viewer": "esbuild --bundle --format=esm --sourcemap --outfile=live-viewer/whatwg-url.mjs index.js",
    "pretest": "node scripts/get-latest-platform-tests.mjs && npm run prepare",
    "test": "node --test test/*.js",
    "precoverage": "npm run pretest",
    "coverage": "c8 node --test test/*.js",
    "prebench": "npm run pretest",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "tr46": "^7.0.0",
    "webidl-conversions": "^8.0.1"
  },
  "devDependencies": {
    "@domenic/eslint-config": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "oxfmt": "0.75.0",
    "tinybench": "^6.2.2",
    "webidl2js": "^21.1.0"
  },
  "c8": {
    "exclude": [
      "lib/Function.js",
      "lib/URL.js",
      "lib/URLSearchParams.js",
      "lib/VoidFunction.js",
      "lib/utils.js",
      "scripts/",
      "test/"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}
